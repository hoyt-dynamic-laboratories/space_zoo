# Space Zoo v0.55.20 — 4wd / B'aa quadruped actor config
# Standardized quadruped: six walk poses + idle down/up. No front/rear turn poses.
actor_id=baa
label=B'AA
locomotion=QUADRUPED
scale=0.500
frame_count=8

# Physical translation remains independent from pose cadence.
